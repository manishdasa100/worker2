# Copy to .env (or .env.dev / .env.prod) and fill in. Real env vars override this file.

# The consumer's settings. Limits, nsjail paths and CALIBRATE knobs belong to
# the executor: they are environment variables of its container (Dockerfile),
# overridden with `docker run -e`.

# --- Executors: one socket per slot, comma-separated; the slot count is their number ---
EXECUTOR_SOCKETS=/run/codinglemons/slot1/executor.sock,/run/codinglemons/slot2/executor.sock

# --- Redis (the backend contract — do not rename streams/keys) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Scoped ACL user (see README "Redis credentials"); blank -> default user.
# Comments stay on their own line: python-dotenv reads `KEY=  # note` as the value "# note".
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_STREAM_KEY=stream:pending-submissions        # Inbound submissions
REDIS_CONSUMER_GROUP=workers
# Blank -> <hostname>:<pid>
REDIS_CONSUMER_NAME=
REDIS_BLOCK_MS=5000
REDIS_AUTOCLAIM_MIN_IDLE_MS=60000
REDIS_RESULT_STREAM_KEY=stream:execution-results   # Outbound results
REDIS_RESULT_STREAM_MAXLEN=10000                   # 0 = unbounded
REDIS_HEARTBEAT_KEY=executor:nsjail:heartbeat      # Liveness key the backend gates enqueues on
REDIS_HEARTBEAT_INTERVAL=10
REDIS_HEARTBEAT_TTL=30

# --- Log ---
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- Worker ---
MAX_CONSECUTIVE_ERRORS=5
