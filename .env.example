# Copy to .env (or .env.dev / .env.prod) and fill in. Real env vars override this file.

# --- Sandbox ---
NSJAIL_PATH=/usr/local/bin/nsjail
NSJAIL_RUN_CONFIG_PATH=./sandbox/run.cfg          # Jail profile for running user code (default-deny seccomp)
NSJAIL_COMPILE_CONFIG_PATH=./sandbox/compile.cfg  # Jail profile for the compiler (sandboxed compile)
JAVA_PATH=/usr/lib/jvm/java-11-openjdk-amd64/bin/java
WALL_CLOCK_GRACE=5                                # TLE is CPU-time based; wall backstop = CPU limit + this (s)

# --- Execution ---
MAX_CONCURRENT=4
DEFAULT_TIME_LIMIT_MS=5000                         # Max CPU-ms budget per test case (clamps the request)
DEFAULT_MEMORY_LIMIT=128                           # MB per sandbox (clamps the request)
MAX_OUTPUT_BYTES=262144
MAX_OUTPUT_LINES=5000
MAX_TESTCASES=50
TEMP_DIR=/tmp/codinglemons
COMPILE_TIMEOUT=30                                 # CPU-seconds for the sandboxed compile step
COMPILE_MEMORY_LIMIT=512                           # MB for the compile jail (g++/javac are hungry)
WARMUP_IDLE_SECONDS=1800                           # Re-warm runtimes after this long idle (0 = off)

# --- CALIBRATE task ---
CALIBRATION_RUNS=5
CALIBRATION_TIME_LIMIT=30
CALIBRATION_MEMORY_LIMIT=1024

# --- Redis (the backend contract — do not rename streams/keys) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=                                    # Scoped ACL user (see README "Redis credentials"); blank -> default user
REDIS_PASSWORD=
REDIS_STREAM_KEY=stream:pending-submissions        # Inbound submissions
REDIS_CONSUMER_GROUP=workers
REDIS_CONSUMER_NAME=                               # Blank -> <hostname>:<pid>
REDIS_BLOCK_MS=5000
REDIS_AUTOCLAIM_MIN_IDLE_MS=60000
REDIS_RESULT_STREAM_KEY=stream:execution-results   # Outbound results
REDIS_RESULT_STREAM_MAXLEN=10000                   # 0 = unbounded
REDIS_HEARTBEAT_KEY=executor:nsjail:heartbeat      # Liveness key the backend gates enqueues on
REDIS_HEARTBEAT_INTERVAL=10
REDIS_HEARTBEAT_TTL=30

# --- Log ---
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- Worker ---
MAX_CONSECUTIVE_ERRORS=5
