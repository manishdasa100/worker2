// Seccomp policy: COMPILE phase (compilers and syntax checks). nsjail loads it
// through seccomp_policy_file in compile.cfg. Adopted from judgebox's policy/compile.kafel.
//
// Identical to run.kafel (read its design rules) except where compilers genuinely
// need more:
//   * process creation: g++ spawns cc1plus, as, collect2 and ld.
//     fork/vfork/clone (non-namespace) are allowed; pids.max still bounds them.
//   * socketpair(AF_UNIX) + send/recv on it: kept from judgebox, where rustc's
//     jobserver needs it (ticket 12). socket() stays denied, so no
//     address-bearing socket of any family can be created.
//   * chmod/fchmod/utimensat/fallocate: linkers marking outputs executable.
// Everything in the "forbidden" policy remains KILL_PROCESS.
// Profiled but left unnamed, so ENOSYS (ticket 08): connect and setsockopt
// (the JVM's, after a socket() this policy already fails with EACCES),
// and javac's flock, which it does without.

// Kafel uses kernel-internal names: newstat/newfstat/newlstat = stat/fstat/lstat,
// sendfile64 = sendfile, umount = umount2, newuname = uname.
// ERRNO values are literal (kafel requires numbers): 38=ENOSYS 11=EAGAIN 13=EACCES 1=EPERM 25=ENOTTY

#define AF_UNIX 1
#define CLONE_NS_MASK 0x7E020080
#define CLONE_THREAD 0x00010000

#define TCGETS     0x5401
#define TIOCGWINSZ 0x5413
#define FIONREAD   0x541B
#define FIONBIO    0x5421
#define FIONCLEX   0x5450
#define FIOCLEX    0x5451

// Note on argument checks: every comparison below is an exact match on the
// full 64-bit register, so high-bit tricks (pid=0x1_00000000 truncating to 0,
// cmd=0x1_00005412 truncating to TIOCSTI) fail closed.

POLICY forbidden {
  KILL_PROCESS {
    ptrace, process_vm_readv, process_vm_writev, process_madvise, kcmp,
    pidfd_getfd, bpf, perf_event_open, userfaultfd,
    keyctl, add_key, request_key,
    mount, umount, pivot_root, chroot, unshare, setns, move_mount, open_tree,
    fsopen, fsconfig, fsmount, fspick, mount_setattr,
    kexec_load, kexec_file_load, init_module, finit_module, delete_module,
    reboot, swapon, swapoff, acct, quotactl, syslog,
    open_by_handle_at, name_to_handle_at, lookup_dcookie, fanotify_init,
    iopl, ioperm, modify_ldt,
    settimeofday, clock_settime, clock_adjtime, adjtimex,
    sethostname, setdomainname, uselib, vhangup
  }
}

POLICY compile_allow {
  ALLOW {
    // --- file descriptors and I/O ---
    read, write, readv, writev, pread64, pwrite64, preadv, pwritev, preadv2, pwritev2,
    open, openat, close, lseek, dup, dup2, dup3, fcntl, pipe, pipe2,
    poll, ppoll, select, pselect6,
    epoll_create, epoll_create1, epoll_ctl, epoll_wait, epoll_pwait,
    eventfd, eventfd2, fsync, fdatasync, ftruncate, sendfile64,

    // --- filesystem metadata (rootfs is read-only; only /tmp is writable) ---
    newstat, newfstat, newlstat, newfstatat, statx, statfs, fstatfs,
    access, faccessat, faccessat2, readlink, readlinkat,
    getdents, getdents64, getcwd, chdir, fchdir,
    mkdir, mkdirat, rmdir, unlink, unlinkat, rename, renameat, renameat2, umask,

    // --- memory ---
    mmap, munmap, mprotect, mremap, madvise, msync, mincore, brk,

    // --- threads and sync ---
    futex, set_robust_list, set_tid_address, rseq, arch_prctl, sched_yield,
    // getcpu: gVisor has no rseq and no vDSO getcpu, so glibc's sched_getcpu
    // (JVM startup) makes the real syscall (ticket 07). Returns CPU and node only.
    getcpu,
    sched_getaffinity, sched_getparam, sched_getscheduler,
    sched_get_priority_max, sched_get_priority_min,

    // --- identity / introspection (all namespaced) ---
    getpid, getppid, gettid, getuid, geteuid, getgid, getegid, getgroups,
    getresuid, getresgid, getpgrp, getpgid, getsid, capget, newuname, sysinfo,
    getpriority, getrusage, times, prctl,

    // --- time ---
    clock_gettime, clock_getres, clock_nanosleep, nanosleep, gettimeofday, time,
    alarm, getitimer, setitimer,
    timer_create, timer_settime, timer_gettime, timer_getoverrun, timer_delete,
    timerfd_create, timerfd_settime, timerfd_gettime,

    // --- signals (pid namespace confines targets to this sandbox) ---
    rt_sigaction, rt_sigprocmask, rt_sigreturn, rt_sigsuspend, rt_sigpending,
    rt_sigtimedwait, sigaltstack, kill, tkill, tgkill, restart_syscall,

    // --- process lifecycle ---
    execve, exit, exit_group, wait4, waitid, getrandom
  },

  // Processes and threads, never new namespaces.
  ALLOW {
    clone { (clone_flags & CLONE_NS_MASK) == 0 },
    fork, vfork,
    chmod, fchmod, fchmodat, utimensat, fallocate,
    sendmsg, recvmsg, sendto, recvfrom
  },
  ALLOW {
    socketpair { family == AF_UNIX }
  },
  // Limits can be read or lowered for self only.
  ALLOW {
    prlimit64 { pid == 0 }
  },
  // ioctl: allowlist of request codes, compared as full 64-bit values. A
  // denylist ("request != TIOCSTI") is bypassable because the kernel truncates
  // cmd to 32 bits: 0x1_00005412 passes the check yet executes TIOCSTI.
  ALLOW {
    ioctl(fd, request) {
      request == TCGETS || request == TIOCGWINSZ || request == FIONREAD ||
      request == FIONBIO || request == FIOCLEX || request == FIONCLEX
    }
  },
  ERRNO(25) { ioctl },  // ENOTTY

  // clone3 passes flags via a pointer that seccomp can't inspect: make glibc
  // fall back to clone(2), which we *can* filter.
  ERRNO(38) { clone3, io_uring_setup, io_uring_enter, io_uring_register },
  ERRNO(11) { clone },
  // No sockets of any family; glibc's nscd lookup falls back to files.
  ERRNO(13) { socket, socketpair },
  ERRNO(1)     { prlimit64, sched_setaffinity, setpriority, personality }
}

USE forbidden,
USE compile_allow
DEFAULT ERRNO(38)
